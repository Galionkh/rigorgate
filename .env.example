# Required for live market scans. Create your own credentials; never commit them.
APCA_API_KEY_ID=replace_me
APCA_API_SECRET_KEY=replace_me

# Required for respectful SEC access. Use an application name and real contact email.
SEC_USER_AGENT=YourAppName your-email@example.com

# Optional free-data fallbacks and macro context.
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# Public-safe defaults.
GALION_ALPACA_HISTORICAL_FEED=sip
GALION_ALPACA_REALTIME_FEED=iex
GALION_ALPACA_HISTORICAL_FALLBACK_FEED=iex
GALION_SHADOW_ROUND_TRIP_COST_BPS=10
GALION_CACHE_DIR=data/cache/fundamentals
GALION_SIGNAL_LEDGER=data/signal_ledger.json
