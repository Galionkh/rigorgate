+}
+.button:hover { transform: translateY(-2px); border-color: rgba(94, 231, 255, .5); }
+.button.primary { color: var(--ink); background: linear-gradient(135deg, var(--green), var(--cyan)); border-color: transparent; }
+.button.secondary { backdrop-filter: blur(12px); }
+.button:disabled { opacity: .42; cursor: not-allowed; transform: none; }
+
+.hero-proof {
+  margin-top: 58px;
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  border-top: 1px solid var(--line);
+  padding-top: 22px;
+}
+.hero-proof div { display: flex; flex-direction: column; gap: 2px; }
+.hero-proof strong { font-size: 1.25rem; }
+.hero-proof span { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
+
+.terminal-card {
+  border: 1px solid rgba(94, 231, 255, .21);
+  border-radius: var(--radius);
+  background: linear-gradient(160deg, rgba(14, 36, 52, .9), rgba(5, 16, 27, .94));
+  box-shadow: var(--shadow), inset 0 1px rgba(255,255,255,.05);
+  overflow: hidden;
+  transform: rotate(1deg);
+}
+.terminal-top { display: flex; align-items: center; gap: 18px; height: 52px; padding: 0 20px; border-bottom: 1px solid var(--line); color: var(--muted); font-family: ui-monospace, monospace; font-size: .72rem; }
+.terminal-lights { display: flex; gap: 6px; }
+.terminal-lights i { width: 8px; height: 8px; border-radius: 50%; background: #27414c; }
+.terminal-lights i:first-child { background: var(--red); }
+.terminal-lights i:nth-child(2) { background: var(--amber); }
+.terminal-lights i:last-child { background: var(--green); }
+.terminal-status { margin-left: auto; color: var(--green); }
+.terminal-body { padding: 28px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .84rem; }
+.prompt { color: var(--green); }
+.hero-funnel { margin: 32px 0; display: grid; gap: 14px; }
+.funnel-row { display: grid; grid-template-columns: 155px 1fr 40px; gap: 12px; align-items: center; }
+.funnel-row span { color: var(--muted); font-size: .7rem; }
+.funnel-track { height: 7px; border-radius: 99px; background: rgba(255,255,255,.055); overflow: hidden; }
+.funnel-track i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--green), var(--cyan)); border-radius: inherit; transition: width 1s cubic-bezier(.2,.8,.2,1); }
+.funnel-row strong { text-align: right; font-size: .76rem; }
+.terminal-result { margin: 30px 0; padding: 18px; border: 1px solid rgba(54, 211, 153, .22); background: rgba(54, 211, 153, .06); display: flex; justify-content: space-between; }
+.terminal-result span { color: var(--muted); }
+.terminal-result strong { color: var(--green); }
+.terminal-cursor { color: var(--muted); }
+.cursor { display: inline-block; width: 8px; height: 16px; margin-left: 5px; background: var(--cyan); animation: blink 1s steps(2) infinite; vertical-align: middle; }
+@keyframes blink { 50% { opacity: 0; } }
+
+.manifesto { border-block: 1px solid var(--line); padding: 84px max(20px, calc((100vw - 1240px)/2)); background: rgba(9, 26, 39, .42); }
+.manifesto p { margin: 0 0 12px; color: var(--muted); font-size: 1.05rem; }
+.manifesto h2 { margin: 0; font-size: clamp(2rem, 4vw, 4.7rem); letter-spacing: -.05em; line-height: 1.05; }
+.manifesto em { color: var(--cyan); font-style: normal; }
+
+.challenge-section, .evidence-section, .contribute-section { padding: 120px 0; }
+.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 50px; margin-bottom: 48px; }
+.section-heading h2, .contribute-intro h2, .final-cta h2 { margin: 9px 0 0; font-size: clamp(2.3rem, 4.6vw, 5.2rem); line-height: 1; letter-spacing: -.055em; }
+.section-heading > p { width: min(410px, 100%); margin: 0; color: var(--muted); }
+.section-heading.compact h2 { font-size: clamp(2.3rem, 4vw, 4.4rem); }
+
+.case-tabs { display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; scrollbar-width: none; }
+.case-tab { min-width: 160px; padding: 14px 18px; color: var(--muted); border: 1px solid var(--line); border-radius: 10px 10px 0 0; background: rgba(7, 20, 31, .65); cursor: pointer; text-align: left; }
+.case-tab span { display: block; color: var(--cyan); font-size: .65rem; letter-spacing: .1em; margin-bottom: 4px; }
+.case-tab[aria-selected="true"] { color: var(--text); background: var(--panel); border-color: rgba(94, 231, 255, .3); border-bottom-color: var(--panel); }
+
+.decision-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(330px, .75fr); gap: 16px; }
+.market-panel, .audit-panel { border: 1px solid var(--line); background: rgba(9, 25, 38, .88); box-shadow: 0 20px 60px rgba(0,0,0,.16); }
+.market-panel { border-radius: 0 var(--radius) var(--radius) var(--radius); overflow: hidden; }
+.panel-heading { padding: 26px 30px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
+.panel-heading h3 { font-size: 2rem; margin: 4px 0 0; }
+.panel-heading h3 small { color: var(--muted); font-size: .82rem; font-weight: 500; margin-left: 8px; }
+.synthetic-badge { color: var(--amber); border: 1px solid rgba(243, 201, 105, .32); padding: 7px 10px; border-radius: 999px; font-size: .62rem; letter-spacing: .12em; }
+.chart-wrap { padding: 24px 20px 4px; }
+#price-chart { width: 100%; height: auto; overflow: visible; }
+.chart-grid-line { stroke: rgba(141, 190, 200, .1); stroke-width: 1; stroke-dasharray: 5 7; }
+.metric-strip { display: grid; grid-template-columns: repeat(5, 1fr); border-block: 1px solid var(--line); }
+.metric-strip div { padding: 17px 19px; border-right: 1px solid var(--line); }
+.metric-strip div:last-child { border: 0; }
