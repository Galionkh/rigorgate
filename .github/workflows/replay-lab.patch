+:root {
+  color-scheme: dark;
+  --bg: #06101b;
+  --panel: #0a1826;
+  --panel-2: #0d2030;
+  --line: rgba(157, 208, 218, 0.15);
+  --muted: #86a5ad;
+  --text: #ecfbff;
+  --cyan: #5ee7ff;
+  --green: #36d399;
+  --amber: #f3c969;
+  --red: #ff6b7a;
+  --ink: #031016;
+  --radius: 22px;
+  --shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  min-width: 320px;
+  background:
+    radial-gradient(circle at 80% 8%, rgba(22, 111, 124, 0.22), transparent 30rem),
+    radial-gradient(circle at 5% 35%, rgba(42, 97, 145, 0.15), transparent 34rem),
+    var(--bg);
+  color: var(--text);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  line-height: 1.5;
+}
+
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -2;
+  background-image:
+    linear-gradient(rgba(116, 189, 203, .045) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(116, 189, 203, .045) 1px, transparent 1px);
+  background-size: 72px 72px;
+  mask-image: linear-gradient(to bottom, black 0, transparent 78%);
+}
+
+.noise {
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  opacity: .22;
+  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
+}
+
+a { color: inherit; text-decoration: none; }
+button, a { -webkit-tap-highlight-color: transparent; }
+button { font: inherit; }
+
+.site-header {
+  width: min(1240px, calc(100% - 40px));
+  margin: 0 auto;
+  min-height: 84px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border-bottom: 1px solid var(--line);
+}
+
+.brand { display: flex; align-items: center; gap: 12px; letter-spacing: .01em; }
+.brand strong { letter-spacing: .14em; font-size: .9rem; }
+.brand-mark {
+  width: 32px;
+  height: 36px;
+  display: grid;
+  place-items: center;
+  clip-path: polygon(50% 0, 95% 24%, 95% 76%, 50% 100%, 5% 76%, 5% 24%);
+  background: linear-gradient(145deg, var(--green), var(--cyan));
+}
+.brand-mark span {
+  width: 25px;
+  height: 29px;
+  clip-path: inherit;
+  background: var(--bg);
+}
+
+nav { display: flex; align-items: center; gap: 28px; color: var(--muted); font-size: .9rem; }
+nav a:hover, nav a:focus-visible { color: var(--text); }
+.nav-github { padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; }
+
+main { overflow: hidden; }
+.hero, .challenge-section, .evidence-section, .contribute-section, .final-cta {
+  width: min(1240px, calc(100% - 40px));
+  margin-inline: auto;
+}
+
+.hero {
+  min-height: 750px;
+  display: grid;
+  grid-template-columns: 1.08fr .92fr;
+  align-items: center;
+  gap: 80px;
+  padding: 90px 0 100px;
+}
+
+.eyebrow, .section-index, .case-kicker, .audit-label {
+  color: var(--cyan);
+  letter-spacing: .16em;
+  font-size: .7rem;
+  font-weight: 800;
+}
+.eyebrow { display: flex; gap: 10px; align-items: center; }
+.pulse {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--green);
+  box-shadow: 0 0 0 0 rgba(54, 211, 153, .6);
+  animation: pulse 2s infinite;
+}
+@keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(54, 211, 153, 0); } }
+
+h1 {
+  margin: 22px 0 24px;
+  font-size: clamp(3.3rem, 6vw, 6.8rem);
+  line-height: .96;
+  letter-spacing: -.065em;
+  max-width: 900px;
+}
+h1 span, .contribute-intro h2 span { color: transparent; -webkit-text-stroke: 1px rgba(220, 250, 255, .58); }
+.hero-lede { max-width: 690px; color: #abc3c9; font-size: clamp(1rem, 1.4vw, 1.22rem); }
+.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
+.button {
+  appearance: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 28px;
+  min-height: 50px;
+  padding: 0 20px;
+  border: 1px solid var(--line);
+  border-radius: 11px;
+  color: var(--text);
